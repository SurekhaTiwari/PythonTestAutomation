{
  "info": {
    "name": "API Testing Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET post by id",
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["pm.environment.set('postId', 1);"] }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Id matches', () => pm.expect(pm.response.json().id).to.eql(1));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/{{postId}}" }
    },
    {
      "name": "POST create post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Title returned', () => pm.expect(pm.response.json().title).to.eql('QA post'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"title\":\"QA post\",\"body\":\"Hello\",\"userId\":1}" },
        "url": "{{baseUrl}}/posts"
      }
    },
    {
      "name": "GET invalid post (negative)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/99999" }
    }
  ]
}
